+/* ---------- finale: the PHP Monster's UFO ---------- */
+const UFO = { in: 4.4, beam: [10, 14.8], lift: [10.6, 14.4], out: 16.8, end: 19.6, w: 84, hover: 74 };
+// [from, to, speaker, line]; "cap" is the one who was in the cage
+const UFO_LINES = [
+  [.2, 2.3, "cap", "Teşekkürler {ad}! Prod yeniden yeşil!"],
+  [2.5, 4.3, "hero", "Hafta sonu bizim! Hadi eve gidelim."],
+  [5, 7.4, "php", "<?php echo 'Nereye gidiyorsunuz?'; ?>"],
+  [7.6, 9.3, "hero", "Bu da ne?! PHP Canavarı!"],
+  [9.5, 12, "php", "{0} artık benim legacy projemde çalışacak!"],
+  [12.2, 14.3, "cap", "İmdat! Her yer $değişken dolu!"],
+  [14.6, 16.3, "hero", "{0}'yı bırak, PHP!"],
+  [16.5, 18.8, "php", "Haftaya Cuma görüşürüz! Muhahaha!"],
+];
+const UFO_CUES = [
+  [UFO.in, () => { shake = .5; [880, 660, 880, 660, 880, 660].forEach((f, i) => tone(f, f * .92, .18, "sawtooth", .035, i * .2)); }],
+  [UFO.in + 1.8, () => { shake = .3; sfx.boom(); }],
+  [9.5, () => sfx.roar()],
+  [UFO.beam[0], () => tone(180, 900, 1.4, "triangle", .07)],
+  [UFO.lift[1], () => sfx.down()],
+  [16.5, () => sfx.roar()],
+  [UFO.out, () => tone(300, 1400, .9, "square", .035)],
+];
+const capName = () => swapped() ? T("Musa") : "Ela";
+function ufoPos(t) {
+  const cx = L.cageX * TS + 16, h = UFO.hover + Math.sin(t * 3) * 2.5;
+  if (t < UFO.in) return null;
+  if (t < UFO.in + 1.8) { const k = 1 - Math.pow(1 - (t - UFO.in) / 1.8, 3); return { x: cx + 240 * (1 - k), y: h - 160 * (1 - k), r: -.25 * (1 - k) }; }
+  if (t < UFO.out) return { x: cx, y: h, r: Math.sin(t * 2) * .03 };
+  const k = Math.pow((t - UFO.out) / 2.2, 2);
+  return k < 1 ? { x: cx + 330 * k, y: h - 200 * k, r: .3 * Math.min(1, k * 3) } : null;
+}
+const ufoH = () => UFO.w * (AV.phpUfo.naturalHeight / AV.phpUfo.naturalWidth || .91);
+function capLift(t) {
+  const k = Math.min(1, (t - UFO.lift[0]) / (UFO.lift[1] - UFO.lift[0])), e = k * k * (3 - 2 * k);
+  return { x: L.cageX * TS + 16 + Math.sin(t * 5) * 3 * (1 - k), y: 206 - 84 * e, s: k > .7 ? 1 - (k - .7) / .3 * .75 : 1 };
+}
+function drawAbduction() {
+  const ep = L.endP; if (!ep || ep.phase !== "ufo") return;
+  const t = ep.t, u = ufoPos(t), H = ufoH(), sw = swapped();
+  if (u && t < UFO.out) {
+    const g = ctx.createRadialGradient(DX(u.x), DY(206), 0, DX(u.x), DY(206), 60 * SD);
+    g.addColorStop(0, "rgba(109,255,158,.25)"); g.addColorStop(1, "rgba(109,255,158,0)");
+    ctx.fillStyle = g; ctx.fillRect(DX(u.x - 60), DY(146), Math.round(120 * SD), Math.round(70 * SD));
+  }
+  if (u && t > UFO.beam[0] && t < UFO.beam[1]) {
+    const a = Math.min(1, (t - UFO.beam[0]) / .3, (UFO.beam[1] - t) / .3) * (.85 + Math.sin(time * 30) * .15);
+    const top = u.y + H * .4, g = ctx.createLinearGradient(0, DY(top), 0, DY(206));
+    g.addColorStop(0, `rgba(109,255,158,${.55 * a})`); g.addColorStop(1, `rgba(109,255,158,${.12 * a})`);
+    ctx.fillStyle = g; ctx.beginPath();
+    ctx.moveTo(DX(u.x - 12), DY(top)); ctx.lineTo(DX(u.x + 12), DY(top)); ctx.lineTo(DX(u.x + 30), DY(206)); ctx.lineTo(DX(u.x - 30), DY(206));
+    ctx.closePath(); ctx.fill();
+    for (let i = 0; i < 6; i++) {
+      const yy = 206 - (time * 60 + i * 16) % (206 - top), hw = 12 + 18 * (yy - top) / (206 - top);
+      rect(u.x - hw, yy, hw * 2, 1, `rgba(220,255,230,${.35 * a})`);
+    }
+  }
+  if (t >= UFO.lift[0] && t < UFO.lift[1]) {
+    const c = capLift(t);
+    drawHuman(ctx, sw ? "hurt" : "elaHelp", DX(c.x), DY(c.y), SD * c.s, -1, sw ? 31 : 30, { air: true });
+  }
+  const im = AV.phpUfo;
+  if (u && im.complete && im.naturalWidth) {
